{
    "name": "romainfrigolet/vite-et-gourmand",
    "description": "Application web du traiteur Vite & Gourmand (ECF Studi - TP DWWM)",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mongodb": "*",
        "phpmailer/phpmailer": "^6.9"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" },
        "files": ["src/helpers.php"]
    },
    "config": { "optimize-autoloader": true, "sort-packages": true },
    "repositories": {
        "phpmailer": {
            "type": "vcs",
            "url": "https://github.com/PHPMailer/PHPMailer"
        }
    }
}
