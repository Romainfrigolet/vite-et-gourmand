# --- Application ---
APP_ENV=local            # local | production
APP_DEBUG=true           # false en production
APP_URL=http://localhost:8000

# --- Base relationnelle MySQL / MariaDB ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=vite_gourmand
DB_USER=vg_app
DB_PASSWORD=change-me
# Certificat CA si la base impose TLS (ex. Aiven) : chemin absolu du fichier
DB_SSL_CA=

# --- Base NoSQL MongoDB (statistiques admin) ---
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=vite_gourmand

# --- E-mails ---
# log  : les e-mails sont écrits dans storage/mails/ (développement)
# smtp : envoi réel (Brevo, Mailtrap, Gmail…)
MAIL_DRIVER=log
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM=no-reply@viteetgourmand.fr
# Adresse qui reçoit les messages du formulaire de contact
MAIL_CONTACT=contact@viteetgourmand.fr
